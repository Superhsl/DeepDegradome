@@ -0,0 +1,36 @@
+"""Install and verify the matching database subset; never reuse x86 caches."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import tarfile
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--root', type=Path, required=True)
+parser.add_argument('--destination', type=Path, required=True)
+parser.add_argument('--include-extra', action='store_true')
+args = parser.parse_args()
+args.destination.mkdir(parents=True, exist_ok=True)
+archives = [args.root/'assets'/name for name in ['rosetta-docking-database2020.tar.gz', 'rosetta-sampling-support2020.tar.gz']]
+if args.include_extra:
+    archives.append(args.root/'assets/native-full-20261019/rosetta-database-extra-native-01.tar.gz')
+records = []
+for archive in archives:
+    record = json.loads(archive.with_suffix('.gz.source.json').read_text())
+    assert hashlib.sha256(archive.read_bytes()).hexdigest() == record['archive_sha256']
+    with tarfile.open(archive) as stream:
+        for member in stream:
+            relative = Path(member.name)
+            target = args.destination/relative
+            assert not relative.is_absolute() and '..' not in relative.parts
+            assert target.resolve().is_relative_to(args.destination.resolve())
+            if member.issym() or member.islnk():
+                assert (target.parent/member.linkname).resolve().is_relative_to(args.destination.resolve())
+            stream.extract(member, args.destination)
+    for entry in record['files']:
+        content = (args.destination/entry['path']).read_bytes()
+        digest = hashlib.sha1(b'blob '+str(len(content)).encode()+b'\0'+content).hexdigest()
+        assert digest == entry['git_blob_sha1'], entry['path']
+    records.append({'archive': archive.name, 'sha256': record['archive_sha256'], 'files_verified': len(record['files'])})
+    print(json.dumps(records[-1]), flush=True)
+(args.destination/'native-database-lock.json').write_text(json.dumps(records, indent=2)+'\n')
diff --git a/sdaa/build/latx/README.md b/sdaa/build/latx/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..05d246b114da810ba0b3fd1fc2ac8e90a7b6521b
--- /dev/null
+++ b/sdaa/build/latx/README.md
@@ -0,0 +1,9 @@
+# LATX CPU 兼容运行
+
+PatchDock、Cyndi、iFitDock 的现有核心为 x86 程序，使用 LATX 在龙芯 CPU 上执行。这不是原工具的龙芯原生重编译，也不使用 SDAA 代替 CPU 搜索。
+
+源码与构建依赖身份见 [latx-source.json](../../locks/latx-source.json)、[meson-wheel.json](../../locks/meson-wheel.json)，已准备运行包的哈希见 [latx-runtime.json](../../locks/latx-runtime.json)。
+
+`build.sh SOURCE NEW_BUILD 64|32` 整理自实际 configure／ninja 命令，需要已有编译依赖和 `MESON` 包装器。此封装入口未重新完成一次独立全量编译；现有验证使用已锁定的外部运行包。
+
+x86 sysroot、原工具、编译产物及其许可分别管理，不随源码目录自动提供。更换运行包后应核对哈希并重做相应工具固定输入验收。计时包含 CPU、翻译器和启动成本，不解释为纯翻译开销。
diff --git a/sdaa/build/latx/build.sh b/sdaa/build/latx/build.sh
new file mode 100755
index 0000000000000000000000000000000000000000..69e6184dbb6a84a63d8d410c6e709e3c87e97bf2
--- /dev/null
+++ b/sdaa/build/latx/build.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -euo pipefail
+SOURCE=$(realpath "${1:?LAT source checkout at locks/latx-source.json commit}")
+BUILD=$(realpath -m "${2:?new absolute build directory}")
+TARGET=${3:-64}
+MESON=${MESON:?absolute executable Meson 0.63.3 wrapper required}
+test "$(uname -m)" = loongarch64
+test -f "$SOURCE/configure"
+test ! -e "$BUILD"
+mkdir -p "$BUILD"
+cd "$BUILD"
+EXTRA=()
+case "$TARGET" in
+ 64) ARCH=x86_64-linux-user;;
+ 32) ARCH=i386-linux-user; EXTRA=(--enable-guest-base-zero --disable-pie);;
+ *) echo 'target must be 32 or 64' >&2; exit 2;;
+esac
+"$SOURCE/configure" --target-list="$ARCH" "${EXTRA[@]}" --enable-latx --optimize-O1 --disable-blobs --disable-debug-info --disable-docs --disable-linux-io-uring --disable-werror --extra-ldflags=-ldl --meson="$MESON"
+ninja -j"${JOBS:-8}"
diff --git a/sdaa/build/package_rosetta.py b/sdaa/build/package_rosetta.py
