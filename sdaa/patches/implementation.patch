+def pdb(p):
+    result=[]
+    for line in p.read_text().splitlines():
+        if line.startswith(('ATOM  ','HETATM')):
+            result.append((line[12:27],tuple(float(line[i:i+8]) for i in [30,38,46])))
+    return result
