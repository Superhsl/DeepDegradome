+            'numerical_tolerances':{'general_mol2':1e-5,'pdb_rmsd_angstrom':1e-3,'pdb_max_angstrom':2e-3,'charge_e':1e-4},
+            'cpu_execution_completed':all(read(x/'completion.json')['execution_completed'] for x in [gc,lc]),'tools':{}}
