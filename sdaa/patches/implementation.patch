+                     '-v',str(out.parent)+':/out']
+            if a.target=='loong':command+=['-v',str(root/'native/latx-48a9c55d/lat64')+':/translator:ro']
+            command+=['--entrypoint','python3',image,'/runner.py','--backend','x86' if a.target=='gpu1' else 'latx',
