+        r={'timing':pair([x['seconds'] for x in ga],[x['seconds'] for x in la]),'comparisons':[]}
+        for x,y in zip(ga,la):
+            gd=g/'translation-three-repeats'/('%s-%02d'%(tool,x['repeat']));ld=l/'translation-three-repeats'/('%s-%02d'%(tool,y['repeat']))
