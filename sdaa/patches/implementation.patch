+(out/'requirements-wheels.txt').write_text('\n'.join(x['name']+'=='+x['version']+' --hash=sha256:'+x['sha256'] for x in manifest)+'\n')
+(out/'SHA256SUMS').write_text(''.join(x['sha256']+'  wheelhouse/'+x['filename']+'\n' for x in manifest))
