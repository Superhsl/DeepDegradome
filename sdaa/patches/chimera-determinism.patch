@@ -1,3 +1,19 @@
+
+def _stable_amber_bond_records(path):
+    text = open(path).read()
+    prefix, section = text.split('@<TRIPOS>BOND\n', 1)
+    bonds, sep, rest = section.partition('@<TRIPOS>')
+    rows = [line.split() for line in bonds.splitlines() if line.strip()]
+    assert all(len(row) == 4 for row in rows)
+    edges = sorted((min(int(r[1]), int(r[2])),
+                    max(int(r[1]), int(r[2])), r[3]) for r in rows)
+    ordered = ''.join('%6d %5d %5d %s\n' % (i, x, y, kind)
+                      for i, (x, y, kind) in enumerate(edges, 1))
+    output = prefix + '@<TRIPOS>BOND\n' + ordered + sep + rest
+    # Atom rows and the complete molecular graph are preserved.
+    assert output.split('@<TRIPOS>BOND\n', 1)[0] == prefix
+    open(path, 'w').write(output)
+
