ARG BASE_IMAGE=sha256:3e425da47a74a03b589f8e1c18a67dcb90c8bcbde977cc1df09fa01209b7a524
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 HOME=/tmp TORCH_SDAA_CONV_USE_FP32=0
LABEL org.opencontainers.image.title="DeepDegradome source-based LoongArch SDAA inference" \
      org.opencontainers.image.base.name="lasermpnn-sdaa321-loong:torch2.12.0-sdaa3.2.1-py312" \
      org.opencontainers.image.base.digest="sha256:3e425da47a74a03b589f8e1c18a67dcb90c8bcbde977cc1df09fa01209b7a524"
WORKDIR /out
ENTRYPOINT ["python3.12"]
